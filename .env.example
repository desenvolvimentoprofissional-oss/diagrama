# Somente no servidor. Cadastre no Secrets do AI Studio; nunca use prefixo VITE_.
OPENAI_API_KEY=""
# Opcional. Modelo com Responses API, visão e saídas estruturadas.
OPENAI_MODEL="gpt-5"
# O padrão CRA-SP já está no código. Não são necessários Secrets de layout ou logotipo.
# Ferramentas opcionais: omita se já estiverem no PATH do servidor.
# CHROMIUM_PATH="/usr/bin/chromium"
# LIBREOFFICE_PATH="/usr/bin/soffice"
# PDFTOPPM_PATH="/usr/bin/pdftoppm"
PORT=3000
